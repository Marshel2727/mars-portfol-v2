# Copy this file to .env and replace every CHANGE_ME value before deployment.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD
DB_NAME=mars_portfol
DB_USER=mars_user
DB_PASSWORD=CHANGE_ME_APPLICATION_DATABASE_PASSWORD
DB_HOST_PORT=3307

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# Comma-separated public origins allowed to call the backend.
FRONTEND_URL=https://example.com,https://www.example.com

# Optional web-push configuration. Leave blank when push notifications are unused.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com
